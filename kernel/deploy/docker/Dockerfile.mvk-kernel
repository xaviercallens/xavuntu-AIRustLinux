# ============================================================
# MVK Rust Kernel - QEMU-in-Pod Container Image
# ============================================================
# Multi-stage build:
#   Stage 1: Cross-compile MVK demo_kernel to i686 ELF
#   Stage 2: Runtime with QEMU + benchmark tools
# ============================================================

# --- Stage 1: Build the MVK Rust Kernel ---
FROM rust:1.87-bookworm AS builder

# Install cross-compilation target
RUN rustup target add i686-unknown-linux-gnu && \
    apt-get update && \
    apt-get install -y gcc-multilib && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY . .

WORKDIR /build/examples/demo_kernel

# Build the demo kernel for i686
RUN cargo build \
    --target i686-unknown-linux-gnu \
    --release

# Build the CRC32 benchmark binary (native)
RUN cargo build \
    --manifest-path benchmarks/c_vs_rust_perf_report.py \
    --release 2>/dev/null || true

# --- Stage 2: Runtime ---
FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    qemu-system-x86 \
    iperf3 \
    sysbench \
    stress-ng \
    python3 \
    python3-pip \
    curl \
    jq \
    procps \
    net-tools \
    gcc \
    libc6-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /mvk

# Copy the built kernel binary
COPY --from=builder /build/examples/demo_kernel/target/i686-unknown-linux-gnu/release/demo_kernel /mvk/kernel/demo_kernel

# Copy benchmark scripts
COPY benchmarks/c_vs_rust_perf_report.py /mvk/benchmarks/
COPY scripts/qemu_boot_test.py /mvk/scripts/

# Copy the entrypoint
COPY deploy/docker/entrypoint-mvk.sh /mvk/entrypoint.sh
RUN chmod +x /mvk/entrypoint.sh

# Expose benchmark ports
EXPOSE 5201/tcp 5201/udp 12865/tcp

# Health check: verify QEMU process is running
HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD pgrep -f qemu-system || exit 1

ENTRYPOINT ["/mvk/entrypoint.sh"]
CMD ["benchmark"]
